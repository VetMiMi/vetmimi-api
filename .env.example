# Copy to .env for local development. Real values never go in git.
# The full list with purposes is in docs/architecture.md, "Configuration".
# Comments sit on their own lines because some .env readers (docker run
# --env-file among them) keep an inline comment as part of the value.

# HTTP listen port (default 8080).
PORT=8080
# development | production. Production refuses to start without every secret.
ENV=development
# debug | info | warn | error (default info).
LOG_LEVEL=info

# PostgreSQL connection string.
DATABASE_URL=postgres://localhost:5432/vetmimi?sslmode=disable
# Server for go test; each test binary creates and drops its own vetmimi_test_<random> database on it.
DATABASE_URL_TEST=postgres://localhost:5432/vetmimi_test?sslmode=disable
# Redis for asynq and rate limits.
REDIS_URL=redis://localhost:6379/0
# Redis database used by tests.
REDIS_URL_TEST=redis://localhost:6379/1

# Shared with the Next.js server; required on public routes and sign-in. 32+ characters in production.
SERVICE_KEY=
# 32+ random bytes; HMAC key for management and join tokens and room tickets.
SIGNING_SECRET=
# 32 bytes, standard base64 (openssl rand -base64 32); encrypts TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=
# The API's public origin, used to build the wss:// URL in room tickets.
PUBLIC_API_URL=http://localhost:8080
# The public site, for links in emails, the WebSocket Origin check and revalidation.
SITE_URL=http://localhost:3000
# Shared with the site's POST /api/revalidate.
SITE_REVALIDATE_SECRET=

# Resend API key. Empty in development: emails are logged as "would send".
RESEND_API_KEY=
# Daw Mi's approved sender, e.g. VetMiMi <hello@...>.
EMAIL_FROM=

# S3-compatible endpoint for media.
MEDIA_S3_ENDPOINT=
# Region name the storage provider expects.
MEDIA_S3_REGION=auto
# Bucket for originals and derivatives.
MEDIA_S3_BUCKET=
# Bucket access key. Empty on the live host: the EC2 instance role grants the bucket.
MEDIA_S3_ACCESS_KEY=
# Bucket secret key; set together with MEDIA_S3_ACCESS_KEY.
MEDIA_S3_SECRET_KEY=
# Base URL the bucket's public/ prefix is served from.
MEDIA_PUBLIC_URL=

# coturn host:port. Empty in development: room tickets offer STUN only.
TURN_HOST=
# coturn static-auth-secret for time-limited credentials.
TURN_SECRET=

# Meta app id for publishing to the Facebook Page and Instagram (docs/meta-setup.md). Empty: posted by hand.
META_APP_ID=
# Meta app secret; set together with META_APP_ID.
META_APP_SECRET=
# Facebook Login for Business configuration id naming the permissions (docs/meta-setup.md).
META_CONFIG_ID=
# Graph API version the connector calls (default v26.0).
META_GRAPH_VERSION=v26.0

# LinkedIn app client id for publishing to Daw Mi's profile (docs/linkedin-setup.md). Empty: posted by hand.
LINKEDIN_CLIENT_ID=
# LinkedIn app client secret; set together with LINKEDIN_CLIENT_ID.
LINKEDIN_CLIENT_SECRET=
# LinkedIn-Version header (YYYYMM) the connector sends (default 202609).
LINKEDIN_API_VERSION=202609

# Anthropic API key for the portal's AI assistant. Empty: the assistant is off.
ANTHROPIC_API_KEY=
# Model the assistant asks (default claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Internal metrics listener, e.g. 127.0.0.1:9090; never exposed by Caddy. Empty disables.
METRICS_ADDR=127.0.0.1:9090
