# Copy to .env for local development. Real values never go in git.
# The full list with purposes is in docs/architecture.md, "Configuration".

PORT=8080
ENV=development                      # development | production
DATABASE_URL=postgres://localhost:5432/vetmimi?sslmode=disable
DATABASE_URL_TEST=postgres://localhost:5432/vetmimi_test?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1
SERVICE_KEY=                         # shared with the Next.js server for /public routes
SITE_URL=http://localhost:3000       # the public site, for links in emails
SITE_REVALIDATE_SECRET=              # shared with the site's /api/revalidate
RESEND_API_KEY=
EMAIL_FROM=                          # Daw Mi's approved sender, e.g. "VetMiMi <hello@...>"
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_PUBLIC_URL=                    # base URL the bucket is served from
TURN_HOST=                           # coturn host:port
TURN_SECRET=                         # shared secret for time-limited TURN credentials
LOG_LEVEL=info                       # debug | info | warn | error
SIGNING_SECRET=                      # HMAC key for management and session join tokens
TOTP_ENCRYPTION_KEY=                 # 32-byte base64 key encrypting stored TOTP secrets
PUBLIC_API_URL=http://localhost:8080 # the API's own public URL, used in WebSocket tickets
MEDIA_S3_REGION=auto
METRICS_ADDR=127.0.0.1:9090          # internal metrics listener; never exposed by Caddy
