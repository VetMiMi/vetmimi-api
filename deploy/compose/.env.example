# The live host's own values. Copy to deploy/compose/.env on the host
# (deploy/README.md); the API's application variables go in api.env instead.
# Generate every secret on the host with openssl rand -hex 32.

# The website's host name, e.g. 203-0-113-7.sslip.io until a real domain exists.
SITE_DOMAIN=
# The API's host name, e.g. api-203-0-113-7.sslip.io; also the TURN host name.
API_DOMAIN=
# PostgreSQL password for the vetmimi role; hex, because it sits inside DATABASE_URL.
POSTGRES_PASSWORD=
# Shared by the API (SERVICE_KEY) and the website (API_SERVICE_KEY).
SERVICE_KEY=
# Shared by the API and the website's POST /api/revalidate.
SITE_REVALIDATE_SECRET=
# coturn static-auth-secret, shared with the API; hex, because coturn's entrypoint re-parses it.
TURN_SECRET=
# The Elastic IP (terraform output public_ip); coturn advertises it in relay candidates.
TURN_EXTERNAL_IP=
# The backups bucket (terraform output backups_bucket) that backup.sh uploads to.
BACKUP_BUCKET=
# Optional IndexNow key for the website.
INDEXNOW_KEY=
