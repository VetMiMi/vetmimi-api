{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh api repos/VetMiMi/*)",
      "Bash(gh api graphql:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go mod:*)",
      "Bash(go generate:*)",
      "Bash(go install:*)",
      "Bash(gofmt:*)",
      "Bash(staticcheck:*)",
      "Bash(sqlc:*)",
      "Bash(oapi-codegen:*)",
      "Bash(goose:*)",
      "Bash(make:*)",
      "Bash(scripts/gate.sh:*)",
      "Bash(psql:*)",
      "Bash(redis-cli:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform init -backend=false:*)",
      "Bash(docker compose config:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(docker compose up:*)",
      "Bash(brew services stop:*)"
    ]
  }
}
